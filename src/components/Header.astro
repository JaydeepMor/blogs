---
import { withBase } from '../lib/posts';
interface Props { active?: 'blogs' | 'about' }
const { active } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href={withBase('', base)}><span class="brand-mark">JM</span><span class="name">Jaydeep Mor</span></a>
    <nav class="nav" aria-label="Main">
      <a class:list={{ active: active === 'blogs' }} href={withBase('', base)}>Blogs</a>
      <a class:list={{ active: active === 'about' }} href={withBase('about/', base)}>About</a>
    </nav>
    <div class="search-wrap">
      <label class="search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
        <input type="search" id="search-input" placeholder="Search posts" aria-label="Search posts" autocomplete="off">
      </label>
      <div class="search-results" id="search-results" hidden></div>
    </div>
    <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch light or dark theme">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3a9 9 0 100 18 9 9 0 000-18zm0 16V5a7 7 0 010 14z"></path></svg>
    </button>
  </div>
</header>
