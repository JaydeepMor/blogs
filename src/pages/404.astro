---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/posts';
const base = import.meta.env.BASE_URL;
---
<Base title="Page not found">
  <section class="hero">
    <h1>This page does not exist.</h1>
    <p>The post may have been removed or its address may have changed.</p>
    <div class="chip-row"><a class="btn btn-primary" href={withBase('', base)}>Back to all posts</a></div>
  </section>
</Base>
