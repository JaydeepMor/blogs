---
import Base from '../../layouts/Base.astro';
import CategoryChips from '../../components/CategoryChips.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORIES, categoryBySlug } from '../../lib/categories';
import { getPosts } from '../../lib/content';

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { category: c.slug } }));
}

const category = categoryBySlug(Astro.params.category!);
const posts = (await getPosts()).filter((post) => post.category === category.slug);
---
<Base title={category.label} description={`Posts about ${category.label}.`} active="blogs">
  <section class="hero" style="padding-bottom:24px">
    <h1>{category.label}</h1>
    <CategoryChips current={category.slug} />
  </section>
  {posts.length > 0
    ? <div class="grid">{posts.map((post) => <PostCard post={post} />)}</div>
    : <p class="empty">No posts in this topic yet.</p>}
</Base>
