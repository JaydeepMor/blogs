---
import Base from '../../layouts/Base.astro';
import CategoryChips from '../../components/CategoryChips.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORIES, categoryBySlug } from '../../lib/categories';
import { getPosts } from '../../lib/content';
import { breadcrumbLd } from '../../lib/seo';

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { category: c.slug } }));
}

const category = categoryBySlug(Astro.params.category!);
const posts = (await getPosts()).filter((post) => post.category === category.slug);
const crumbs = breadcrumbLd([{ name: 'Blogs', path: '' }, { name: category.label, path: `category/${category.slug}/` }], Astro.site!.href, import.meta.env.BASE_URL);
---
<Base title={`${category.label} articles`} description={`Step-by-step ${category.label} articles with diagrams and code by Jaydeep Mor, senior backend developer.`} active="blogs" jsonLd={[crumbs]}>
  <section class="hero" style="padding-bottom:24px">
    <h1>{category.label}</h1>
    <CategoryChips current={category.slug} />
  </section>
  {posts.length > 0
    ? <div class="grid">{posts.map((post) => <PostCard post={post} />)}</div>
    : <p class="empty">No posts in this topic yet.</p>}
</Base>
