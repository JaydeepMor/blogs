---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/posts';
import { personLd } from '../lib/seo';
const base = import.meta.env.BASE_URL;
const profileLd = { '@context': 'https://schema.org', '@type': 'ProfilePage', mainEntity: personLd(Astro.site!.href, base) };
---
<Base title="About" description="Jaydeep Mor is a senior backend developer building healthcare, fintech and e-commerce systems." active="about" jsonLd={[profileLd]}>
  <section class="hero" style="padding-bottom:0">
    <span class="chip">Senior Backend Developer · Gujarat, India</span>
    <h1 style="margin-top:20px">I build backend systems that stay fast, secure and audit-ready.</h1>
    <p>Nine years across healthcare, fintech and e-commerce. I currently lead the architecture of an AI-powered, multi-tenant healthcare platform, and I write here to explain what I learn in plain steps.</p>
    <div class="chip-row"><a class="btn btn-primary" href="https://www.linkedin.com/in/jaydeep-mor">Connect on LinkedIn</a><a class="btn" href={withBase('', base)}>Read the blog</a></div>
  </section>

  <div class="stats">
    <div class="stat"><b>9+</b><span>years building backend systems</span></div>
    <div class="stat"><b>99.9%</b><span>uptime on a multi-tenant healthcare platform</span></div>
    <div class="stat"><b>75%</b><span>faster API responses through query tuning and caching</span></div>
    <div class="stat"><b>90%</b><span>test coverage, starting from zero</span></div>
  </div>

  <div class="section-head"><h2>What I write about</h2></div>
  <div class="chip-row" style="margin-top:0">
    <span class="chip cat-backend">Laravel, Node.js, Python</span>
    <span class="chip cat-backend">PostgreSQL, MongoDB, Redis</span>
    <span class="chip cat-devops">AWS, Terraform, CI/CD</span>
    <span class="chip cat-security">OAuth 2.0, JWT, encryption</span>
    <span class="chip cat-compliance">HIPAA, GDPR, ISO 27001</span>
    <span class="chip cat-ai">AI &amp; SI: integration and agents</span>
    <span class="chip cat-fullstack">Vue.js, Next.js</span>
  </div>

  <div class="section-head"><h2>Experience</h2></div>
  <div class="timeline">
    <div><span class="meta">Jul 2024 to present</span><h3>Senior Backend Developer · Mbarc Labs</h3><p>Technical architecture for an AI-powered healthcare SaaS: multi-tenant Laravel platform, containerized Python and Node.js services on AWS, and HIPAA compliance that passed every security audit.</p></div>
    <div><span class="meta">Jul 2022 to Jul 2024</span><h3>Senior Laravel Developer · Brightness Software Development</h3><p>E-commerce, fintech and healthcare systems for US and German clients, including a luxury jewelry store built from scratch and a multi-tenant billing platform.</p></div>
    <div><span class="meta">Apr 2020 to Jun 2022</span><h3>Senior Web Developer · Evolution IT Solutions</h3><p>REST APIs with Laravel and Lumen, database tuning, API documentation, and mentoring three junior developers.</p></div>
    <div><span class="meta">2015 to 2020</span><h3>Web Developer · BitLogic and Infinity Infoway</h3><p>Client-facing delivery of Laravel, Angular and PHP applications across the full project lifecycle.</p></div>
  </div>
</Base>
